# Optional — the setup page at http://localhost:7333/ is the easy way.
# Anything set here overrides server/credentials.json.

# --- Twitch (bits, subs, gift subs) ---
# Create an app at https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost:7333/twitch/callback
#   Category: Broadcasting Suite
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Your channel's login name (lowercase), e.g. calebvanbiljonn
TWITCH_CHANNEL=

# --- Streamlabs (cash tips) ---
# Streamlabs dashboard -> Account Settings -> API Settings -> API Tokens -> "Your Socket API Token"
STREAMLABS_SOCKET_TOKEN=
